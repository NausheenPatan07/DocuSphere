# ==============================================================================
# DocuSphere Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the backend directory:
#   cp .env.example .env   (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# IMPORTANT: Never commit actual passwords, private database strings,
# or JWT secrets to source control.
# ==============================================================================

# Flask Secret Key for session signing
SECRET_KEY=replace_with_a_secure_random_flask_secret_key

# JWT Signing Secret Key (minimum 32 characters recommended for HMAC-SHA256)
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key

# MongoDB Connection String (MongoDB Atlas SRV or local replica set)
# Example: mongodb+srv://<username>:<password>@<cluster-address>/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
MONGO_DB_NAME=docusphere_db

# Allowed Frontend Origin for CORS handling
FRONTEND_URL=http://localhost:5173

# Optional: Flask Debug Mode (True/False - defaults to False in production)
FLASK_DEBUG=False
